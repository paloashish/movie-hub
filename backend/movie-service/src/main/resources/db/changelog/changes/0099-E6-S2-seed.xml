<?xml version="1.0" encoding="UTF-8"?>
<!-- E6-S2: sample catalogue for a demo. Runs only in the "seed" context (the local profile) and only when the
     movie table is empty; Liquibase then records it and never runs it again. Ids start at 100001 so they never
     collide with rows the identity column hands out, and so credits line up with the people seeded in
     people-service by the same ids (application-architecture 4.6). Posters are our own SVGs on the classpath. -->
